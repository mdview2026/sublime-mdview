// Default settings for the mdview live preview plugin (see README.md for details)
// mdview 实时预览插件默认设置（各项含义见包内 README.md）
{
    // Path to the mdview executable; empty = auto-detect
    // (.md file association → registry InstallDir → common install dirs → PATH)
    // mdview 可执行文件路径；留空自动探测（.md 关联 → 注册表 InstallDir → 常见目录 → PATH）
    "mdview_path": "",

    // Push throttle interval in milliseconds: one frame per interval during continuous typing
    // 推送节流间隔（毫秒）：连续输入期间每该间隔出一帧
    "debounce_ms": 300,

    // Master switch for live push
    // 实时推送总开关
    "enabled": true,

    // Master switch for two-way cursor/click/selection position sync
    // 光标/点击/选区位置双向同步总开关
    "sync_cursor": true,

    // mdview download channel: auto = Chinese OS UI language → CN build, others →
    // international build; force with cn / intl
    // mdview 下载通道：auto = OS 界面语言中文 → 国内版，其余 → 国际版；可强制 cn / intl
    "channel": "auto",

    // Troubleshooting: write detailed logs to <live dir>/plugin-debug.log
    // 排查用：往 <live 目录>/plugin-debug.log 写详细日志
    "debug_log": false
}
